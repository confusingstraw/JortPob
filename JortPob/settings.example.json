{
  "MORROWIND_PATH": "P:\\ATH\\TO\\MORROWIND\\",
  "ELDEN_PATH": "P:\\ATH\\TO\\ELDENRING\\",
  "WWISE_PATH": "P:\\ATH\\TO\\WWISE\\",
  "OUTPUT_PATH": "P:\\ATH\\TO\\MOD\\FOLDER\\",
  "THREAD_COUNT": 16,
  "LOAD_ORDER": [
    "Morrowind.esm"
  ],
  "DEFAULT_PROCESS_TIMEOUT": 15000, // when running a subprocess this is the default timeout time in millis.
  "RANDOM_SEED": 42, // When doing anything random we use this as our seed so results are consistent between builds
  "DEBUG_SKIP_CUSTOM_MAP": false,
  "DEBUG_SKIP_SOUND": false, // can make dialog unuseable
  "DEBUG_SKIP_NON_ESSENTIAL_ITEMS": false, // if true we only generate items that referenced in script files directly, or have overrides. minor speedup
  "DEBUG_SKIP_ICONS": false, // skip generating icons and previews for items. All icons will show default fallback icon (saves 1~ minute on builds)
  "DEBUG_DONT_WRITE_BLANK_MSBS": false, // if true we don't overwrite base game overworld tiles with blanks. probably no reason to set this to true but it's here
  "DEBUG_DISCARD_ANIMATED_DOORS": true, // disables all doors that are NOT load doors
  "DEBUG_SKIP_FMG_PARAM_SORTING": false,
  "DEBUG_SKIP_ESD": false, // skip building dialog AND scripts
  "DEBUG_SKIP_NICE_WATER_CIRCLIFICATION": true, // slow as shit, skipping this saves about a minute per build
  "DEBUG_EXCLUSIVE_CELL_BUILD_BY_NAME": null,  // set to "null" to build entire map.
  "DEBUG_EXCLUSIVE_BUILD_BY_BOX": [-3, -10, -1, -8 ],  // also set to null to build entire map. format x1, y1, x2, y2. smaller values first, 1 = 1 cell, use cell coordinates
  // seyda neen area (small) = [-3, -10, -1, -8 ]
  // seyda neen area (large) = [ -5, -15, 5, -5 ]
  // balmora area (small) = [-4, -3, -2, -1]
  // caldera area (small) = [-3, 1, 0, 3]
  // balmora + caldera combo = [-4, -3, -1, 3]
  // lava area near Marandus and Ashunartes = [1, -5, 5, -1]
  // all lava areas (big) = [0, -5, 15, 10]
  // lava area near Galom Daeus = [8, -2, 12, 2]
  // lava and swamp areas combined = [-10, -10, 15, 5];
  // half the map = [-10, -15, 20, 0];
  "DEBUG_SKIP_TERRAIN_BORDER_BLENDING": true, // big speedup on builds, allows multithreading of landscape processing, but makes terrain borders very ugly
  "DEBUG_SKIP_INTERIOR": false,
  // if a cell name contains any of the strings in this list (even partial matches) we build it, otherwise skip.
  // set MATCHES to null if for proper normal building
  "DEBUG_EXCLUSIVE_INTERIOR_BUILD_NAME": null,  // ["Seyda Neen", "Addamasartus", "Nimawia Grotto", "Thelas Ancestral Tomb", "Samarys Ancestral Tomb", "Andrano Ancestral Tomb", "Abaesen-Pulu Egg Mine" ],
  "DEBUG_HKX_FORCE_BINARY": true,
}